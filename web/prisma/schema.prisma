generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id              String    @id @default(cuid())
  name            String?
  videoUrl        String
  videoId         String
  lastCollectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]
  prizes          Prize[]
}

model Comment {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commentId       String   @unique
  authorName      String?
  authorChannelId String?
  text            String
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([eventId])
}

model Prize {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates PrizeCandidate[]
  winners    PrizeWinner[]

  @@index([eventId])
}

model PrizeCandidate {
  id              String   @id @default(cuid())
  prizeId         String
  prize           Prize    @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  userKey         String
  authorName      String?
  authorChannelId String?
  createdAt       DateTime @default(now())

  winners PrizeWinner[]

  @@unique([prizeId, userKey])
  @@index([prizeId])
}

model PrizeWinner {
  id          String         @id @default(cuid())
  prizeId     String
  prize       Prize          @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   PrizeCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([prizeId, candidateId])
  @@index([prizeId])
  @@index([candidateId])
}
